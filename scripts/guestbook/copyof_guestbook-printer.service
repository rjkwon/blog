[Unit]
Description=Kwon's guestbook printer poller
After=network-online.target
Wants=network-online.target

[Service]
User=kwon
WorkingDirectory=/home/kwon/guestbook
ExecStart=/home/kwon/guestbook/venv/bin/python -u /home/kwon/guestbook/firebase_poller.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target